PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/sam
JWT_SECRET=replace_with_a_unique_64_character_random_value
DATA_DIR=./data
MAX_UPLOAD_MB=100
CORS_ORIGIN=http://localhost:5173
NODE_ENV=development
# For a public HTTPS deployment configure TLS and an appropriate reverse proxy.
# Optional: install Ghostscript (gs on Linux, gswin64c on Windows) for PDF compression.
